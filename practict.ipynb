   "source": [
    "def reverse_str(text:str) -> str:\n",
    "    chars = list(text)\n",
    "    left = 0\n",
    "    right = len(chars) - 1\n",
    "    while left < right:\n",
    "        chars[left],chars[right] = chars[right],chars[left]\n",
    "        left += 1\n",
    "        right -= 1\n",
    "    return \"\".join(chars)\n",
    "\n",
    "reverse_str(\"python\")"
   ]
  }
 ],
